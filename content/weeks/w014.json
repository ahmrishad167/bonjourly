   "note": "fixed formal inversion"
  },
  {
   "fr": "Quel est ton numéro de téléphone?",
   "en": "What's your phone number?",
   "note": "quel + être"
  },
  {
   "fr": "C'est quoi, ton nom?",
   "en": "What's your name?",
   "note": "casual, very Quebec"
  },
  {
   "fr": "Comment ça coûte?",
   "en": "How much is it?",
   "note": "Quebec informal for combien ça coûte"
  },
  {
   "fr": "Qu'est-ce tu veux?",
   "en": "What do you want?",
   "note": "Quebec casual: qu'est-ce que → qu'est-ce"
  }
